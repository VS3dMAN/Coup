{
  "name": "coup-game",
  "version": "1.0.0",
  "description": "Online multiplayer Coup card game - social deduction game",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install && npm install --workspace=client && npm install --workspace=server",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "coup",
    "card-game",
    "multiplayer",
    "social-deduction"
  ],
  "author": "",
  "license": "MIT"
}